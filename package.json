{
  "name": "cockpit",
  "version": "0.2.18",
  "private": true,
  "description": "A calm, free-form board on your PC for links to read later, files, sticky notes, a daily journal, snippets and what your AI agents make.",
  "type": "module",
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.js",
    "dev": "vite --config web/vite.config.ts",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p web --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "setup": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/react": "^0.1.0-beta.13",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "playwright-core": "1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "1.2.19",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
